/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* concatWithReverse(int* nums, int numsSize, int* returnSize) {
    int n=numsSize;
    int *ans=malloc((n*2)*sizeof(int));
    *returnSize=n*2;
    for(int i=0;i<n;i++){
        ans[i]=nums[i];
    }
    int j=n-1;
    for(int i=n;i<n*2;i++){
        ans[i]=nums[j];
        j--;
    }
    return ans;
}
