Given two strings s and t, return true if they are equal when both are typed into empty text editors. '#' means a backspace character.

Note that after backspacing an empty text, the text will continue empty.

Example 1:

Input: s = "ab#c", t = "ad#c"
Output: true
Explanation: Both s and t become "ac".
Example 2:

Input: s = "ab##", t = "c#d#"
Output: true
Explanation: Both s and t become "".
Example 3:

Input: s = "a#c", t = "b"
Output: false
Explanation: s becomes "c" while t becomes "b".

CODE:
bool backspaceCompare(char* s, char* t) {
    int n1=strlen(s);
    int n2=strlen(t);
    int t1=-1,t2=-1;
    char s1[n1];
    char s2[n2];

    for(int i=0;i<n1;i++){

        if(s[i]!= '#'){
            char c =s[i];
            s1[++t1]=c;
        }
        else {
           if(t1 >= 0)
              t1--;
        }
    }
    for(int i=0;i<n2;i++){
       
        if(t[i]!= '#'){
            s2[++t2]=t[i];
        }
        else {
            if(t2 >= 0)
               t2--;
        }
    }
    if(t1!=t2){
        return false;
    }

    for(int i=t1;i>=0;i--){
        if(s1[i]!=s2[i]){
            return false;
        }
    }
    return true;
    }
