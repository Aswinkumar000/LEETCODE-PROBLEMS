Given two strings s and t, return true if t is an anagram of s, and false otherwise.

 

Example 1:

Input: s = "anagram", t = "nagaram"

Output: true

Example 2:

Input: s = "rat", t = "car"

Output: false

CODE:
bool isAnagram(char* s, char* t) {
    int n1= strlen(s);
    int n2=strlen(t);
    if(n1!=n2){
        return false;
    }
    int f1[26]={0};
    int f2[26]={0};
    for(int i=0;i<n1;i++){
        int pos=s[i]-97;
        f1[pos]+=1;
    }
        for(int i=0;i<n2;i++){
        int pos=t[i]-97;
        f2[pos]+=1;
    }
        for(int i=0;i<26;i++){
        if(f1[i]!=f2[i]){
          return false;
        }
    }
    return true;
}
