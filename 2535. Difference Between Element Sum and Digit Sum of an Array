int differenceOfSum(int* nums, int numsSize) {
    int sum=0,s=0;
    for(int i=0;i<numsSize;i++){
        sum=sum+nums[i];
    }
       for(int i=0;i<numsSize;i++){
        int a=nums[i];
        while(a>0){
            int r=a%10;
            s=s+r;
            a=a/10;
        }
    }
    return sum-s;
}
