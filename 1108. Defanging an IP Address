char * defangIPaddr(char * address){
    int n1=strlen(address);
    int ans=n1+7;
    char *s = malloc(ans * sizeof(char));
    int j=0;
    for(int i=0;i<n1;i++){
        if(address[i]== '.'){
           s[j++]='[';
           
           s[j++]='.';
        
           s[j++]=']';
           
        }
        else {
        s[j]=address[i];
        j++;
        }
    }
    s[j]='\0';
    return s;
}
